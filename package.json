{
  "name": "hustle-rt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time 2D fighting game with deep, data-driven combat mechanics.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
